# ── SUPABASE CONFIGURATION ──────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AUDIO & CLOUDFLARE R2 CONFIGURATION ─────────────────────────────
# Endpoint public CDN của R2 (dùng cho web frontend phát trực tiếp)
VITE_AUDIO_API_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Thông tin xác thực Cloudflare R2 API (lấy từ Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=loi-chua-audio

# Đường dẫn thư mục audio cục bộ (tùy chọn, mặc định là private/audio)
# AUDIO_PRIVATE_ROOT=private/audio
